---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import LandingPage from "../components/LandingPage.tsx";

const site = "https://caringbeds.com";
const title = "CaringBeds — Hospital Bed Rentals & Sales for Home Care";
const description =
  "Compassionate help finding the right hospital bed for your loved one at home. Rent, buy, or get Medicare and sizing guidance. Free delivery & setup on the Central Coast.";
// Canonical MUST match the served URL incl. trailing slash (trailingSlash:
// 'always' in astro.config.mjs). A no-slash canonical 308-redirects and breaks
// indexing (CHECK_161).
const canonical = `${site}/`;
---
<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="CaringBeds" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CaringBeds" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data: Organization + WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://caringbeds.com/#organization",
          "name": "CaringBeds",
          "url": "https://caringbeds.com/",
          "description":
            "Hospital bed rentals and sales for home care. Compassionate guidance for families.",
          "telephone": "+1-831-555-0100",
          "areaServed": ["Salinas", "Monterey", "Central Coast"],
          "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+1-831-555-0100",
            "contactType": "customer service",
            "availableLanguage": ["English"]
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://caringbeds.com/#website",
          "url": "https://caringbeds.com/",
          "name": "CaringBeds",
          "publisher": { "@id": "https://caringbeds.com/#organization" }
        }
      ]
    })} />
  </Fragment>

  <LandingPage client:load />
</Layout>
